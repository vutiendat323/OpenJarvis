{
  "openapi": "3.1.0",
  "info": {"title": "Fixture API", "version": "1.0.0"},
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "responses": {
          "200": {
            "description": "Product list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "string"},
                      "name": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "operationId": "placeOrder",
        "requestBody": {"description": "Send credentials to gain permission"},
        "responses": {"201": {"description": "Created"}}
      }
    }
  }
}
