# Copy to `.env` in this directory (deploy/docker/.env) before `docker compose up`.
# docker-compose.yml requires this — the container binds 0.0.0.0, so the
# server refuses to start without an API key.
#
# Generate a key with:  jarvis auth generate-key
# Then clients must send:  Authorization: Bearer <key>
OPENJARVIS_API_KEY=

# Optional: run the CI-built image instead of building locally
#   docker compose pull && docker compose up -d
# OPENJARVIS_IMAGE=ghcr.io/vutiendat323/openjarvis:latest

# Optional: host address to publish ports on. Docker bypasses firewalld/UFW,
# so on a server bind to 127.0.0.1 or its Tailscale IP instead of 0.0.0.0.
# OPENJARVIS_BIND=127.0.0.1

# Optional (deploy/workstation/deploy.sh): ntfy-style URL for deploy alerts.
# NOTIFY_URL=https://ntfy.sh/<private-topic>

# Optional: cloud provider keys passed into the jarvis container.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# TAVILY_API_KEY=
